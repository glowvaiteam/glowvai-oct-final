# Razorpay key ID is a publishable checkout identifier. Never put the key secret in VITE_*.
VITE_RAZORPAY_KEY_ID=rzp_test_replace_me
VITE_PAYMENTS_API_URL=/api
# Server-only. Obtain it from the Razorpay dashboard and set it locally; never prefix it with VITE_.
RAZORPAY_KEY_SECRET=
# Optional local-only fallback path to a private backend .env containing matching Razorpay credentials.
RAZORPAY_SECRET_ENV_FILE=
